# =========================
# Telegram
# =========================
#BOT_TOKEN=
#CHAT_ID=

# =========================
# Gemini
# =========================
#GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.1-flash-lite
AI_MIN_CONFIDENCE=0.70
AI_CALL_COOLDOWN_SECONDS=60

# =========================
# Upstox OAuth
# =========================
# The redirect URI must exactly match the URI registered in your Upstox Developer App.

UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8080/
UPSTOX_OAUTH_REQUIRED=true

# Only used when UPSTOX_OAUTH_REQUIRED=false for direct-token debugging.
UPSTOX_ACCESS_TOKEN=
UPSTOX_ACCESS_TOKEN_FILE=data/access_token.txt

# =========================
# Live market data
# =========================
LIVE_FEED_ENABLED=true
UPSTOX_MODE=ltpc
MAX_SUBSCRIBED_INSTRUMENTS=5000
RECONNECT_INTERVAL_SECONDS=5
RECONNECT_ATTEMPTS=50
INSTRUMENT_FILE=data/NSE.json.gz
INSTRUMENT_URL=https://assets.upstox.com/market-quote/instruments/exchange/NSE.json.gz
AUTO_DOWNLOAD_INSTRUMENTS=true

# =========================
# Historical warm-up
# =========================
HISTORY_DB=data/market_history.db
HISTORY_BARS_PER_INSTRUMENT=120
HISTORY_DAYS_BACK=7
HISTORY_REFRESH_STALE_DAYS=7
HISTORY_RATE_LIMIT_PER_MINUTE=480
SESSION_BOOTSTRAP_ENABLED=true
SESSION_BOOTSTRAP_MAX_REQUESTS=500
SESSION_BOOTSTRAP_CONCURRENCY=10
SESSION_BOOTSTRAP_MIN_BARS=6

# =========================
# Dynamic scanner
# =========================
SCANNER_TOP_N=15
SCANNER_MIN_SCORE=45
SCANNER_MIN_VOLUME_RATIO=1.10
SCANNER_MIN_MOMENTUM_5M=0.10
SCANNER_MAX_RSI=72
SCANNER_MIN_BARS=20
SCANNER_MIN_SESSION_BARS=5

# =========================
# Paper risk
# =========================
STARTING_CAPITAL=100000
RISK_PER_TRADE_PCT=0.005
MAX_ALLOCATION_PCT=0.12
STOP_LOSS_PCT=0.008
TARGET_PCT=0.016
MAX_TRADES=5
COOLDOWN_MINUTES=10
ALLOW_SHORT=false

# =========================
# Normal NSE session (local/VPS mode)
# GitHub Actions overrides these in its workflow.
# =========================
ENTRY_START=09:15
ENTRY_END=14:10
SQUARE_OFF=14:15
MARKET_END=14:30
RUN_STOP_TIME=

# =========================
# Runtime
# =========================
EVALUATE_EVERY_SECONDS=60
POSITION_SNAPSHOT_SECONDS=3600
PERSIST_INTERVAL_SECONDS=5
TELEGRAM_SCAN_MESSAGES=false
OUTPUT_DIR=data
